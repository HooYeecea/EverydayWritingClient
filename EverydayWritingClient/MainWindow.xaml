<Window x:Class="EverydayWritingClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:EverydayWritingClient.Controls"
        Title="Everyday Writing"
        Icon="pack://application:,,,/Assets/logo.ico"
        Height="860"
        Width="1280"
        MinHeight="560"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,18,14,16">
                    <Grid>
                        <StackPanel x:Name="BrandExpanded" Orientation="Horizontal">
                            <controls:EwMark Width="34" Height="34" VerticalAlignment="Center" />
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Everyday Writing" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                <TextBlock x:Name="BrandSubtitle" Text="每日英语写作" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <controls:EwMark x:Name="BrandCollapsed" Width="34" Height="34" HorizontalAlignment="Center" Visibility="Collapsed" />
                    </Grid>
                </Border>
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8,8,8,10">
                    <StackPanel>
                        <Button x:Name="CollapseButton" Content="收起侧栏" Style="{StaticResource QuietButton}" Click="ToggleCollapse" />
                        <Button x:Name="SwitchModeButton" Content="管理后台" Style="{StaticResource QuietButton}" Click="ToggleMode" />
                        <Button x:Name="LogoutButton" Content="退出登录" Style="{StaticResource QuietButton}" Click="LogoutClick" />
                    </StackPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="NavPanel" Margin="8,8,8,8" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <ContentControl x:Name="PageHost" Grid.Column="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Grid>
</Window>
