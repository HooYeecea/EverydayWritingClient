<UserControl x:Class="EverydayWritingClient.Views.WritingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EverydayWritingClient.Controls"
             Background="{DynamicResource BgBrush}">
    <Grid Margin="28,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="280" />
            <ColumnDefinition Width="*" MinWidth="220" MaxWidth="460" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,16,0">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="开始写作" Style="{StaticResource PageTitle}" />
                <TextBlock Text="题目、草稿和正式提交与网页端共用。" Margin="0,6,0,14" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                <DockPanel Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Content="换一题" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="RandomTopicClick" />
                    <ComboBox x:Name="TypeBox" Style="{StaticResource FieldCombo}" />
                </DockPanel>
                <Border Background="{DynamicResource SubtleBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                    <TextBlock x:Name="TopicText" TextWrapping="Wrap" FontFamily="Georgia" FontSize="15" Foreground="{DynamicResource TextBrush}" Text="点「换一题」获取题目，或直接写自拟题。" />
                </Border>
                <TextBox x:Name="TitleBox" Style="{StaticResource FieldBox}" Margin="0,0,0,10" ToolTip="标题" />
            </StackPanel>
            <Border Style="{StaticResource Card}" Padding="0">
                <controls:RichEditor x:Name="Editor" />
            </Border>
        </DockPanel>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="写作辅助" FontFamily="Georgia" FontSize="18" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock x:Name="WordText" Margin="0,8,0,8" Foreground="{DynamicResource MutedBrush}" Text="0 词" />
                        <CheckBox x:Name="FocusLockBox" Content="专注锁：禁止切换页面" Margin="0,0,0,8" Checked="FocusChanged" Unchecked="FocusChanged" />
                        <CheckBox x:Name="GrammarBox" Content="提交时语法检查" Margin="0,0,0,4" />
                        <CheckBox x:Name="StructureBox" Content="提交时结构评分" Margin="0,0,0,4" />
                        <CheckBox x:Name="SuggestionBox" Content="提交时提升建议" Margin="0,0,0,4" />
                        <CheckBox x:Name="RealtimeBox" Content="停笔后实时建议" Margin="0,0,0,10" />
                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="保存草稿" Style="{StaticResource GhostButton}" Margin="0,0,8,8" Click="SaveDraftClick" />
                            <Button Content="正式提交" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8" Click="SubmitClick" />
                        </WrapPanel>
                        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="计时" FontFamily="Georgia" FontSize="18" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock x:Name="TimerText" FontSize="32" FontFamily="Georgia" Margin="0,8,0,8" Text="00:00" Foreground="{DynamicResource TextBrush}" />
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left" Text="倒计时分钟" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource MutedBrush}" />
                            <TextBox x:Name="MinutesBox" Style="{StaticResource FieldBox}" Text="30" />
                        </DockPanel>
                        <WrapPanel>
                            <Button Content="开始" Style="{StaticResource GhostButton}" Margin="0,0,8,8" Click="StartTimerClick" />
                            <Button Content="暂停" Style="{StaticResource GhostButton}" Margin="0,0,8,8" Click="PauseTimerClick" />
                            <Button Content="重置" Style="{StaticResource GhostButton}" Margin="0,0,0,8" Click="ResetTimerClick" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="AI 反馈" FontFamily="Georgia" FontSize="18" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock x:Name="AiText" TextWrapping="Wrap" Margin="0,8,0,0" FontFamily="Georgia" FontSize="14" Foreground="{DynamicResource TextBrush}" Text="提交后，或停笔约两秒，会在这里显示建议。" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
