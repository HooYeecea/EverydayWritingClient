<UserControl x:Class="EverydayWritingClient.Views.UserCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgBrush}">
    <DockPanel Margin="28,22">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="用户中心" Style="{StaticResource PageTitle}" />
            <StackPanel Orientation="Horizontal" Margin="0,14,0,12">
                <Button Content="概览" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="TabClick" Tag="overview" />
                <Button Content="个人计划" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="TabClick" Tag="plan" />
                <Button Content="打卡" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="TabClick" Tag="checkin" />
                <Button Content="用量" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="TabClick" Tag="usage" />
                <Button Content="去系统设置" Style="{StaticResource GhostButton}" Click="OpenSettings" />
            </StackPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Body" MaxWidth="880" HorizontalAlignment="Left" />
        </ScrollViewer>
    </DockPanel>
</UserControl>
