<UserControl x:Class="EverydayWritingClient.Views.GuideView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgBrush}">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="使用指南" Style="{StaticResource PageTitle}" />
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
                       Text="桌面端和网页端共用同一个账号、草稿、提交、词库和打卡。" />
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" Content="去做能力测评" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0" Click="OpenTest" />
                    <StackPanel>
                        <TextBlock FontSize="18" FontFamily="Georgia" Text="怎么练" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"
                                   Text="在「开始写作」换一道题目，或自己拟题。正文支持加粗、标题、列表和引用。草稿会自动保存；正式提交后会计入打卡，并可以在「写作记录」里回看。" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock FontSize="18" FontFamily="Georgia" Text="AI" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"
                               Text="可以在系统设置里保存自己的模型 Key，也可以走管理员打开的免费通道。提交时可选语法、结构和提升建议；写作时也可以在停笔后要一条短建议。Key 只留在这台电脑。" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock FontSize="18" FontFamily="Georgia" Text="测评和计划" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"
                               Text="「个人测评」看的是已经写过的作文统计。「英语能力测评」在用户中心进入，包含自评、客观题和两篇短写作，完成后生成个人计划。" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
