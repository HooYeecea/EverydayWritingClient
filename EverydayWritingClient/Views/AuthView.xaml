<UserControl x:Class="EverydayWritingClient.Views.AuthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgBrush}">
    <Grid>
        <Border Style="{StaticResource Card}" MaxWidth="520" Margin="28" HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="28">
            <StackPanel>
                <TextBlock x:Name="TitleText" Style="{StaticResource PageTitle}" FontSize="26" Text="登录" />
                <TextBlock x:Name="HintText" TextWrapping="Wrap" Margin="0,8,0,18" Foreground="{DynamicResource MutedBrush}" Text="使用与网页端相同的账号。" />

                <TextBlock Text="邮箱" Style="{StaticResource SectionLabel}" />
                <TextBox x:Name="EmailBox" Style="{StaticResource FieldBox}" Margin="0,0,0,12" />

                <StackPanel x:Name="OldPasswordPanel" Visibility="Collapsed">
                    <TextBlock Text="当前密码" Style="{StaticResource SectionLabel}" />
                    <PasswordBox x:Name="OldPasswordBox" Style="{StaticResource FieldPassword}" Margin="0,0,0,12" />
                </StackPanel>

                <TextBlock x:Name="PasswordLabel" Text="密码" Style="{StaticResource SectionLabel}" />
                <PasswordBox x:Name="PasswordBox" Style="{StaticResource FieldPassword}" Margin="0,0,0,12" />

                <StackPanel x:Name="CodePanel" Visibility="Collapsed">
                    <TextBlock Text="邮箱验证码" Style="{StaticResource SectionLabel}" />
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="发送验证码" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="SendCodeClick" />
                        <TextBox x:Name="CodeBox" Style="{StaticResource FieldBox}" />
                    </DockPanel>
                </StackPanel>

                <StackPanel x:Name="CaptchaPanel" Visibility="Collapsed" Margin="0,0,0,12">
                    <TextBlock Text="图形验证码" Style="{StaticResource SectionLabel}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="换一张" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="RefreshCaptchaClick" />
                        <Image x:Name="CaptchaImage" Height="40" Stretch="None" HorizontalAlignment="Left" />
                    </DockPanel>
                    <TextBox x:Name="CaptchaBox" Style="{StaticResource FieldBox}" Margin="0,8,0,0" />
                </StackPanel>

                <CheckBox x:Name="AgreementBox" Content="我已阅读并同意用户协议与隐私政策" Margin="0,0,0,14" Visibility="Collapsed" Foreground="{DynamicResource TextBrush}" />

                <Button x:Name="SubmitButton" Content="登录" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Click="SubmitClick" />
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{DynamicResource DangerBrush}" />

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button x:Name="ToRegister" Content="注册账号" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="ToRegisterClick" />
                    <Button x:Name="ToReset" Content="忘记密码" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="ToResetClick" />
                    <Button x:Name="ToLogin" Content="返回登录" Style="{StaticResource GhostButton}" Click="ToLoginClick" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
